<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="project://database/Assets/Lobby/LobbyView.uss" />
    <ui:VisualElement name="game-screen" class="game-screen">
        <ui:ScrollView name="page-scroll" mode="Vertical">
            <ui:VisualElement class="game-header">
                <ui:Label name="game-title" class="game-title" />
                <ui:Label name="round" class="round" />
                <ui:Button name="language-button" class="language-button" />
            </ui:VisualElement>
            <ui:Label name="self-summary" class="game-summary" />
            <ui:Label name="opponent-summary" class="game-summary" />
            <ui:Label name="game-error" class="game-error" />
            <ui:Label name="result" class="result" />
            <ui:Button name="rematch-button" class="game-button" />
            <ui:Button name="leave-button" class="game-button" />
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
