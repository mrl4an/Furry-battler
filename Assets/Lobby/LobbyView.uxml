<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="project://database/Assets/Lobby/LobbyView.uss" />
    <ui:Style src="SessionView.uss" />
    <ui:VisualElement name="root" class="screen session-screen lobby-screen">
        <ui:VisualElement class="session-lobby-shade" picking-mode="Ignore" />
        <ui:VisualElement class="noticeboard">
            <ui:VisualElement class="board-header">
                <ui:VisualElement class="paper-sheet title-sign">
                    <ui:Label name="title" class="title" />
                </ui:VisualElement>
                <ui:Button name="language-button" class="language-button" />
            </ui:VisualElement>
            <ui:Label name="subtitle" class="hidden" />
            <ui:VisualElement class="lobby-body">
                <ui:VisualElement class="paper-sheet connection-section player-pass">
                    <ui:Label name="connection-heading" class="section-title" />
                    <ui:VisualElement class="raccoon-stamp" picking-mode="Ignore" />
                    <ui:Label name="nickname-label" class="field-label" />
                    <ui:VisualElement class="nickname-row">
                        <ui:TextField name="nickname-input" max-length="20" />
                        <ui:Button name="nickname-button" class="secondary-button" />
                    </ui:VisualElement>
                    <ui:Label name="nickname-hint" class="hidden" />
                    <ui:Label name="server-label" class="field-label" />
                    <ui:TextField name="server-url" />
                </ui:VisualElement>
                <ui:VisualElement class="paper-sheet lobby-actions invitation">
                    <ui:VisualElement name="entry" class="entry">
                        <ui:Button name="create-button" class="primary-button" />
                        <ui:VisualElement class="invite-divider">
                            <ui:VisualElement class="ink-rule" picking-mode="Ignore" />
                            <ui:Label name="or-label" class="field-label centered" />
                            <ui:VisualElement class="ink-rule" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Label name="code-label" class="field-label" />
                        <ui:VisualElement class="join-row">
                            <ui:TextField name="room-code" max-length="8" />
                            <ui:Button name="join-button" class="secondary-button" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="room" class="room hidden">
                        <ui:Label name="room-heading" class="section-title" />
                        <ui:Label name="room-code-display" class="room-code" />
                        <ui:Label name="players" class="field-label" />
                        <ui:Label name="room-players" class="field-label" />
                        <ui:Button name="room-ready-button" class="primary-button" />
                        <ui:VisualElement class="room-actions">
                            <ui:Button name="copy-button" class="secondary-button" />
                            <ui:Button name="leave-button" class="secondary-button" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="status" class="paper-sheet status status-tag" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
