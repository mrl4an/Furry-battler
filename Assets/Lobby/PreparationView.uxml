<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="project://database/Assets/Lobby/LobbyView.uss" />
    <ui:VisualElement name="game-screen" class="game-screen preparation-screen">
        <ui:VisualElement class="game-header">
            <ui:Label name="game-title" class="game-title" />
            <ui:Label name="round" class="round" />
            <ui:Label name="timer" class="timer" />
            <ui:Button name="language-button" class="language-button" />
        </ui:VisualElement>
        <ui:Label name="stage-heading" class="stage-title" />
        <ui:VisualElement class="summary-row">
            <ui:Label name="self-summary" class="game-summary" />
            <ui:Label name="opponent-summary" class="game-summary" />
        </ui:VisualElement>
        <ui:Label name="game-error" class="game-error" />
        <ui:VisualElement name="page-content" class="page-content">
            <ui:VisualElement class="preparation-top">
                <ui:VisualElement class="surface board-surface">
                    <ui:Label name="board-heading" class="section-title" />
                    <ui:VisualElement name="board" class="card-grid board-row" />
                </ui:VisualElement>
                <ui:VisualElement class="surface hand-surface">
                    <ui:Label name="hand-heading" class="section-title" />
                    <ui:VisualElement class="hand-controls">
                        <ui:Button name="hand-previous" class="game-button" />
                        <ui:ScrollView name="hand" mode="Horizontal" class="capsule-scroll hand-scroll" horizontal-scroller-visibility="Auto" vertical-scroller-visibility="Hidden" />
                        <ui:Button name="hand-next" class="game-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="surface shop-surface">
                <ui:VisualElement class="section-header">
                    <ui:Label name="shop-heading" class="section-title" />
                    <ui:Button name="refresh-button" class="game-button" />
                </ui:VisualElement>
                <ui:VisualElement name="shop" class="card-grid offer-scroll" />
            </ui:VisualElement>
            <ui:VisualElement class="surface results-surface">
                <ui:Label name="results-heading" class="section-title" />
                <ui:ScrollView name="auction-results" mode="Horizontal" class="capsule-scroll results-scroll" horizontal-scroller-visibility="Auto" vertical-scroller-visibility="Hidden" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="action-bar">
            <ui:Label name="drag-hint" class="hint" />
            <ui:Label name="ready-status" class="hint" />
            <ui:Button name="ready-button" class="game-button primary-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
