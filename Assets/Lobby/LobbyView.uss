:root { --ink: #291F24; --panel: #342D38; --plum: #493E48; --paper: #E9D4B5; --cream: #F3E4D1; --muted: #C2B3BA; --teal: #63DCC5; --coral: #D77C6F; --gold: #DBB773; }
.screen, .game-screen { -unity-font-definition: initial; -unity-font: url("Fonts/NotoSans-Regular.ttf"); color: var(--cream); font-size: 18px; background-color: var(--ink); position: absolute; left: 0; right: 0; top: 0; bottom: 0; padding: 4px 12px; }
.screen { align-items: center; justify-content: center; }
.panel { background-color: var(--panel); padding: 20px; width: 100%; max-width: 1120px; max-height: 100%; border-left-width: 4px; border-left-color: var(--gold); }
.header, .game-header, .summary-row, .section-header, .action-bar, .hand-controls { flex-direction: row; align-items: center; }
.header, .section-header { justify-content: space-between; }
.title, .game-title, .section-title, .result, .card-name { -unity-font: url("Fonts/NotoSerif-Bold.ttf"); -unity-font-style: normal; }
.title { font-size: 28px; flex-grow: 1; white-space: normal; color: var(--paper); }
.subtitle { color: var(--muted); font-size: 16px; margin: 4px 0 16px 0; white-space: normal; }
.section { margin-bottom: 20px; }
.field-label { color: var(--cream); margin: 6px 0; white-space: normal; }
.centered { align-self: center; margin: 12px; color: var(--muted); }
.section-title { color: var(--paper); font-size: 18px; margin: 0 0 4px 0; white-space: normal; }
.room-code { color: var(--teal); font-size: 26px; -unity-text-align: middle-center; margin: 4px; letter-spacing: 4px; }
.status { color: var(--gold); font-size: 14px; margin-top: 8px; white-space: normal; }
Button { background-color: var(--paper); color: #2B2225; min-height: 40px; padding: 4px 10px; margin: 4px 0; border-top-width: 2px; border-bottom-width: 4px; border-left-width: 2px; border-right-width: 2px; border-top-color: #A18B78; border-bottom-color: var(--ink); border-left-color: #A18B78; border-right-color: var(--ink); border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-left-radius: 5px; border-bottom-right-radius: 5px; font-size: 16px; white-space: normal; -unity-text-align: middle-center; }
Button:hover { background-color: #F3E4D1; border-top-color: var(--teal); border-left-color: var(--teal); }
Button:active { background-color: #C2AA8D; border-bottom-width: 2px; }
Button:focus { border-top-color: var(--teal); border-bottom-color: var(--teal); border-left-color: var(--teal); border-right-color: var(--teal); }
Button:disabled { background-color: #514650; color: #AA9DA5; border-top-color: #665964; border-left-color: #665964; }
.primary-button { background-color: var(--teal); color: var(--ink); -unity-font-style: bold; }
.primary-button:hover { background-color: #85E8D5; }
.primary-button:active { background-color: #43B8A5; }
.primary-button:disabled { background-color: #46655F; color: #B3C3BE; }
.language-button { width: 52px; min-width: 52px; margin-left: 16px; flex-shrink: 0; }
.hidden { display: none; }
TextField, IntegerField { color: var(--cream); min-height: 40px; font-size: 16px; margin: 4px 0; }
.unity-base-field__label { color: var(--cream); min-width: 0; margin-right: 8px; }
.unity-base-text-field__input, .unity-text-field__input, #unity-text-input { background-color: var(--ink); color: var(--cream); font-size: 16px; min-height: 34px; padding: 4px 8px; -unity-text-align: middle-left; border-top-width: 1px; border-bottom-width: 2px; border-left-width: 1px; border-right-width: 1px; border-top-color: #796573; border-bottom-color: #796573; border-left-color: #796573; border-right-color: #796573; }
.unity-base-text-field__input:focus { border-bottom-color: var(--teal); }
.game-header { flex-shrink: 0; padding: 0 12px; background-color: var(--panel); border-bottom-width: 2px; border-bottom-color: var(--gold); }
.game-title { color: var(--paper); font-size: 22px; flex-grow: 1; }
.round, .timer { font-size: 16px; color: var(--paper); margin-left: 16px; }
.timer { color: var(--gold); min-width: 136px; -unity-text-align: middle-right; }
.summary-row { flex-shrink: 0; justify-content: space-between; padding: 4px 12px; }
.game-summary { color: var(--cream); white-space: normal; font-size: 14px; flex-shrink: 1; }
#self-summary { margin-right: 24px; }
.game-error { color: var(--coral); font-size: 14px; white-space: normal; flex-shrink: 0; margin: 0 16px; }
.hint, .slot-title, .battle-health { color: var(--muted); font-size: 14px; white-space: normal; }
.hint { margin: 4px 0; }
.action-bar { background-color: var(--panel); padding: 2px 12px; flex-shrink: 0; border-top-width: 2px; border-top-color: #796573; }
.action-bar .hint { flex-grow: 1; margin-right: 16px; }
.action-bar Button { width: 220px; min-height: 40px; flex-shrink: 0; }
.slot-title { min-height: 18px; margin-bottom: 2px; font-size: 13px; flex-shrink: 0; color: var(--paper); -unity-text-align: middle-center; }
.game-card:hover { background-color: #584956; }
.empty-card .card-name { color: var(--muted); background-color: transparent; }
.empty-card .card-meta, .empty-card .card-art, .empty-card .card-ability, .empty-card .card-stats, .empty-card .card-copies { display: none; }
.attack-line { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.drag-ghost { position: absolute; background-color: var(--paper); color: var(--ink); padding: 12px; font-size: 20px; }
/* Screen areas share available height; only unbounded collections scroll. */
.page-content { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-height: 0; margin: 4px 0; }
.stage-title { color: var(--paper); font-size: 16px; margin: 2px 12px; flex-shrink: 0; }
.surface { background-color: var(--panel); padding: 6px 8px; margin-bottom: 4px; border-left-width: 3px; border-left-color: #796573; min-height: 0; }
.card-grid { flex-direction: row; flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-height: 0; align-items: stretch; }
.offer, .board-slot { width: 20%; min-width: 0; flex-shrink: 1; min-height: 0; padding: 0 3px; }
.game-card { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-height: 0; padding: 5px; border-top-width: 2px; border-bottom-width: 3px; border-left-width: 2px; border-right-width: 2px; border-top-color: #A18B78; border-bottom-color: #A18B78; border-left-color: #A18B78; border-right-color: #A18B78; border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-left-radius: 6px; border-bottom-right-radius: 6px; background-color: var(--plum); }
.card-meta, .card-footer { flex-direction: row; justify-content: space-between; align-items: center; flex-shrink: 0; }
.card-tier { color: var(--gold); font-size: 12px; flex-shrink: 0; margin-right: 4px; }
.card-group { color: var(--cream); font-size: 12px; white-space: normal; flex-shrink: 1; -unity-text-align: middle-right; }
.card-art { display: none; }
.card-name { color: #2B2225; background-color: var(--paper); font-size: 17px; white-space: normal; padding: 2px 3px; -unity-text-align: middle-center; flex-shrink: 0; }
.card-ability { color: var(--cream); font-size: 14px; white-space: normal; margin: 2px 0; flex-grow: 1; flex-shrink: 0; }
.card-stats { color: var(--gold); font-size: 18px; -unity-font-style: bold; white-space: normal; }
.card-copies { color: var(--muted); font-size: 11px; white-space: normal; margin-left: 4px; }
.card-footer .card-stats { flex-shrink: 1; }
.card-footer .card-copies { flex-shrink: 1; }
.offer-actions { flex-direction: row; flex-shrink: 0; }
.offer-actions Button { width: 50%; min-width: 0; flex-shrink: 1; min-height: 32px; font-size: 13px; padding: 2px; margin: 3px 0 0 0; }
.board-slot > Button, .hand-item > Button { min-height: 28px; font-size: 13px; padding: 1px 4px; margin: 2px 0 0 0; flex-shrink: 0; }
.preparation-top { flex-direction: row; flex-grow: 1; flex-basis: 0; min-height: 0; }
.board-surface { width: 76%; flex-shrink: 1; }
.hand-surface { width: 24%; flex-shrink: 1; margin-left: 4px; }
.shop-surface { flex-grow: 1; flex-basis: 0; min-height: 0; }
.section-header { flex-shrink: 0; }
.section-header Button { min-height: 28px; font-size: 13px; padding: 1px 8px; margin: 0 0 3px 0; }
.hand-controls { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-height: 0; align-items: stretch; }
.hand-controls > Button { width: 24px; min-width: 24px; min-height: 0; font-size: 13px; padding: 0; margin: 0; }
.hand-scroll { flex-grow: 1; min-width: 0; min-height: 0; }
.hand-scroll > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container { flex-direction: row; height: 100%; }
.hand-item { width: 144px; height: 100%; padding: 0 2px; flex-shrink: 0; justify-content: center; }
.hand-item .game-card { max-height: 140px; }
.hand-item .card-name { font-size: 14px; }
.hand-item .card-ability { font-size: 12px; }
.hand-item .card-tier, .hand-item .card-group { font-size: 10px; }
.hand-item .card-stats { font-size: 14px; }
.hand-item .card-copies { font-size: 10px; }
.action-bar #drag-hint { flex-grow: 1; flex-shrink: 1; font-size: 12px; }
.action-bar #ready-status { flex-grow: 0; flex-shrink: 0; font-size: 13px; }
.results-surface { flex-direction: row; flex-shrink: 0; height: 32px; padding: 2px 8px; align-items: center; }
.results-surface .section-title { font-size: 13px; margin: 0 10px 0 0; flex-shrink: 0; }
.results-scroll { flex-grow: 1; min-width: 0; height: 28px; }
.results-scroll > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container { flex-direction: row; align-items: center; }
.results-scroll .hint { flex-shrink: 0; font-size: 12px; white-space: nowrap; margin: 0 18px 0 0; }
.auction-surface { flex-grow: 1; min-height: 0; }
.auction-screen .game-card { padding: 10px; }
.auction-screen .card-art { display: flex; flex-grow: 1; flex-shrink: 1; min-height: 0; max-height: 180px; background-color: #61535E; color: #C2B3BA; -unity-text-align: middle-center; font-size: 16px; }
.auction-screen .card-name { font-size: 24px; padding: 5px; }
.auction-screen .card-ability { font-size: 18px; flex-grow: 0; margin: 8px 0; }
.auction-screen .card-tier, .auction-screen .card-group { font-size: 16px; }
.auction-screen .card-stats { font-size: 24px; }
.auction-screen .offer > Button, .auction-screen .offer > IntegerField { flex-shrink: 0; }
.auction-screen .offer .unity-base-field__label { font-size: 14px; }
.battle-surface { flex-grow: 1; flex-basis: 0; min-height: 0; }
.battle-health { color: var(--coral); font-size: 16px; -unity-font-style: bold; margin-top: 2px; -unity-text-align: middle-center; flex-shrink: 0; white-space: normal; }
.battle-screen .card-stats { display: none; }
.result-screen .page-content { justify-content: center; align-items: center; }
.result-panel { width: 70%; max-width: 640px; padding: 24px; background-color: var(--panel); border-top-width: 4px; border-top-color: var(--gold); }
.result { color: var(--paper); font-size: 42px; white-space: normal; margin-bottom: 20px; -unity-text-align: middle-center; }
.lobby-body, .nickname-row, .room-actions, .join-row { flex-direction: row; }
.lobby-body { min-height: 0; }
.connection-section { width: 36%; padding-right: 24px; }
.lobby-actions { width: 64%; padding-left: 24px; border-left-width: 1px; border-left-color: #796573; }
.lobby-actions .room { min-height: 0; }
.nickname-row TextField, .join-row TextField { flex-grow: 1; min-width: 0; }
.nickname-row Button, .join-row Button { margin-left: 8px; }
.room-actions Button { width: 50%; flex-shrink: 1; }
.room-actions #copy-button { margin-right: 8px; }
/* Native scrolling and pointer handling stay intact; the track fades in on activity. */
.capsule-scroll .unity-scroller--horizontal { height: 14px; min-height: 14px; margin: 1px 0; background-color: transparent; }
.capsule-scroll .unity-scroller--vertical { width: 14px; min-width: 14px; margin: 0 1px; background-color: transparent; }
.capsule-scroll .unity-scroller__low-button, .capsule-scroll .unity-scroller__high-button { display: none; }
.capsule-scroll .unity-scroller__slider { margin: 0; padding: 0; min-height: 0; min-width: 0; }
.capsule-scroll .unity-base-slider__tracker { background-color: rgba(243, 228, 209, 0.035); border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-left-radius: 20px; border-bottom-right-radius: 20px; transition-property: background-color; transition-duration: 0.25s; }
.capsule-scroll .unity-scroller--horizontal .unity-base-slider__tracker { height: 2px; }
.capsule-scroll .unity-scroller--vertical .unity-base-slider__tracker { width: 2px; }
.capsule-scroll .unity-base-slider__dragger { background-color: rgba(99, 220, 197, 0.38); border-top-width: 0; border-bottom-width: 0; border-left-width: 0; border-right-width: 0; border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-left-radius: 20px; border-bottom-right-radius: 20px; transition-property: background-color; transition-duration: 0.2s; }
.capsule-scroll .unity-scroller--horizontal .unity-base-slider__dragger { height: 6px; min-width: 28px; }
.capsule-scroll .unity-scroller--vertical .unity-base-slider__dragger { width: 6px; min-height: 28px; }
.capsule-scroll .unity-base-slider__dragger-border { display: none; }
.capsule-scroll.scroll-active .unity-base-slider__tracker, .capsule-scroll.scroll-dragging .unity-base-slider__tracker, .capsule-scroll .unity-scroller:hover .unity-base-slider__tracker { background-color: rgba(243, 228, 209, 0.18); }
.capsule-scroll.scroll-active .unity-base-slider__dragger, .capsule-scroll.scroll-dragging .unity-base-slider__dragger, .capsule-scroll .unity-scroller:hover .unity-base-slider__dragger { background-color: var(--teal); }
.compact .game-title { font-size: 20px; }
.compact .stage-title { font-size: 14px; margin: 0 12px; }
.compact .summary-row { padding: 2px 12px; }
.compact .game-summary { font-size: 13px; }
.compact .surface { padding: 3px 6px; }
.compact .card-name { font-size: 16px; }
.compact .card-ability { font-size: 13px; }
.compact .card-stats { font-size: 16px; }
.compact .hand-item .card-name { font-size: 14px; }
.compact .hand-item .card-ability { font-size: 12px; }
.compact .hand-item .card-stats { font-size: 14px; }
.compact .auction-surface .card-name { font-size: 21px; }
.compact .auction-surface .card-ability { font-size: 16px; }
.compact .auction-surface .card-stats { font-size: 22px; }
.rarity-rare { border-top-color: #A6BEC3; border-bottom-color: #A6BEC3; border-left-color: #A6BEC3; border-right-color: #A6BEC3; }
.rarity-epic { border-top-color: #A999B0; border-bottom-color: #A999B0; border-left-color: #A999B0; border-right-color: #A999B0; }
.empty-card { background-color: #302933; border-top-color: #665964; border-bottom-color: #665964; border-left-color: #665964; border-right-color: #665964; justify-content: center; }

.slot-heading { flex-direction: row; align-items: center; min-height: 24px; flex-shrink: 0; margin-bottom: 2px; }
.slot-heading .slot-title { flex-grow: 1; flex-shrink: 1; font-size: 12px; -unity-text-align: middle-left; margin: 0; }
.slot-heading Button { min-height: 24px; font-size: 11px; padding: 0 4px; margin: 0 0 0 4px; flex-shrink: 0; }
.auction-screen .empty-card .card-art { display: none; }
.results-scroll .unity-scroller--horizontal { height: 8px; min-height: 8px; margin: 0; }
.results-scroll .unity-scroller--horizontal .unity-base-slider__dragger { height: 6px; }
/* Noticeboard lobby: text and controls remain live over sliced artwork. */
.lobby-screen { background-image: url("Art/LobbyCourtyard.png"); background-size: cover; background-position: center; background-repeat: no-repeat; -unity-background-image-tint-color: #F2E0D8; padding: 12px 36px; color: #291F24; }
.noticeboard { width: 100%; max-width: 1060px; height: 100%; max-height: 650px; padding: 8px 16px; }
.board-timber { position: absolute; top: 70px; bottom: 24px; left: 0; right: 0; background-color: #60424A; border-top-width: 7px; border-bottom-width: 9px; border-left-width: 8px; border-right-width: 8px; border-top-color: #291F24; border-bottom-color: #291F24; border-left-color: #291F24; border-right-color: #291F24; }
.timber-plank { flex-grow: 1; background-color: #62474D; border-bottom-width: 5px; border-bottom-color: #35272D; border-top-width: 2px; border-top-color: #8B6264; }
.paper-sheet { background-image: url("Art/NoticePaper.png"); background-color: transparent; -unity-slice-left: 180; -unity-slice-right: 180; -unity-slice-top: 150; -unity-slice-bottom: 150; -unity-slice-scale: 0.2px; }
.board-header { flex-direction: row; align-items: center; flex-shrink: 0; height: 116px; margin-bottom: 10px; }
.title-sign { flex-grow: 1; height: 100%; padding: 16px 40px; justify-content: center; }
.lobby-screen .title { -unity-font: url("Fonts/RubikDirt-Regular.ttf"); -unity-font-style: normal; font-size: 48px; color: #291F24; -unity-text-align: middle-center; white-space: normal; }
.lobby-screen Button, .lobby-screen .field-label, .lobby-screen .section-title { -unity-font: url("Fonts/RussoOne-Regular.ttf"); -unity-font-style: normal; }
.lobby-screen Button { background-color: transparent; background-image: url("Art/NoticePaper.png"); -unity-slice-left: 180; -unity-slice-right: 180; -unity-slice-top: 150; -unity-slice-bottom: 150; -unity-slice-scale: 0.09px; -unity-background-image-tint-color: #F3CF93; border-top-width: 0; border-bottom-width: 0; border-left-width: 0; border-right-width: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-left-radius: 0; border-bottom-right-radius: 0; min-height: 48px; padding: 8px 16px; color: #291F24; transition-property: translate, -unity-background-image-tint-color; transition-duration: 0.1s; }
.lobby-screen Button:hover { background-color: transparent; -unity-background-image-tint-color: #FFF4DE; translate: 0 -2px; }
.lobby-screen Button:active { translate: 1px 2px; -unity-background-image-tint-color: #D6B886; }
.lobby-screen Button:focus { border-bottom-width: 2px; border-bottom-color: #327D71; }
.lobby-screen Button:disabled { -unity-background-image-tint-color: #B0A293; color: #65565B; translate: 0 0; }
.lobby-screen .language-button { width: 70px; min-width: 70px; height: 66px; margin-left: 8px; font-size: 24px; }
.lobby-screen .lobby-body { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-height: 0; margin: 0 2px; }
.lobby-screen .connection-section { width: 33%; padding: 22px 24px 24px 24px; min-height: 0; }
.lobby-screen .lobby-actions { width: 67%; border-left-width: 0; padding: 32px 36px 28px 36px; min-height: 0; margin-left: 8px; flex-shrink: 1; justify-content: center; }
.lobby-screen .connection-section .section-title { color: #291F24; font-size: 21px; -unity-text-align: middle-center; white-space: normal; margin-bottom: 4px; }
.raccoon-stamp { background-image: url("Art/RaccoonStamp.png"); background-size: contain; background-position: center; background-repeat: no-repeat; width: 100%; height: 100px; min-height: 0; flex-shrink: 1; margin: 0 0 6px 0; }
.lobby-screen .field-label { color: #291F24; font-size: 18px; margin: 4px 0 2px 0; white-space: normal; }
.lobby-screen #server-label { font-size: 16px; margin-top: 8px; }
.lobby-screen .nickname-row { align-items: center; flex-shrink: 0; }
.lobby-screen .nickname-row TextField { flex-shrink: 1; }
.lobby-screen .nickname-row Button { font-size: 11px; min-height: 36px; padding: 4px 8px; margin-left: 4px; }
.lobby-screen TextField { color: #291F24; min-height: 42px; margin: 0; flex-shrink: 0; }
.lobby-screen .unity-base-text-field__input, .lobby-screen .unity-text-field__input, .lobby-screen #unity-text-input { -unity-font: url("Fonts/RussoOne-Regular.ttf"); background-color: rgba(255, 245, 222, 0.55); color: #291F24; font-size: 20px; min-height: 40px; padding: 4px 9px; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 3px; border-left-width: 2px; border-top-color: #59404D; border-right-color: #59404D; border-bottom-color: #291F24; border-left-color: #59404D; border-top-left-radius: 3px; border-top-right-radius: 5px; border-bottom-left-radius: 5px; border-bottom-right-radius: 2px; }
.lobby-screen #server-url #unity-text-input { -unity-font: url("Fonts/NotoSans-Regular.ttf"); font-size: 14px; }
.lobby-screen #unity-text-input:focus { border-top-color: #327D71; border-right-color: #327D71; border-bottom-color: #327D71; border-left-color: #327D71; }
.lobby-screen .entry { justify-content: center; }
.lobby-screen .primary-button { background-image: url("Art/PaintedButton.png"); -unity-slice-left: 220; -unity-slice-right: 220; -unity-slice-top: 140; -unity-slice-bottom: 140; -unity-slice-scale: 0.18px; -unity-background-image-tint-color: white; color: #291F24; min-height: 72px; font-size: 25px; padding: 12px 24px; }
.lobby-screen #create-button { min-height: 112px; font-size: 33px; }
.lobby-screen .primary-button:hover { -unity-background-image-tint-color: #D1FFF5; }
.lobby-screen .primary-button:active { -unity-background-image-tint-color: #A5CEC2; }
.lobby-screen .primary-button:disabled { -unity-background-image-tint-color: #8C9992; color: #54464C; }
.invite-divider { flex-direction: row; align-items: center; margin: 14px 10px 10px 10px; }
.ink-rule { flex-grow: 1; height: 2px; background-color: #59404D; }
.lobby-screen .invite-divider .centered { -unity-font: url("Fonts/RussoOne-Regular.ttf"); color: #59404D; font-size: 17px; margin: 0 12px; }
.lobby-screen .join-row { align-items: center; }
.lobby-screen #room-code { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.lobby-screen #join-button { width: 152px; flex-shrink: 0; min-height: 62px; font-size: 27px; margin: 0 0 0 12px; }
.lobby-screen .status-tag { -unity-font: url("Fonts/RussoOne-Regular.ttf"); align-self: center; color: #291F24; font-size: 16px; margin-top: 6px; padding: 10px 30px; min-height: 42px; max-width: 90%; -unity-text-align: middle-center; white-space: normal; flex-shrink: 0; -unity-slice-scale: 0.08px; }
.lobby-screen .room-code { -unity-font: url("Fonts/RubikDirt-Regular.ttf"); color: #59404D; background-color: rgba(255, 245, 222, 0.5); font-size: 30px; padding: 4px 12px; margin: 4px 0; }
.lobby-screen #room-players { color: #59404D; -unity-font: url("Fonts/RussoOne-Regular.ttf"); font-size: 16px; }
.lobby-screen .room-actions Button { font-size: 13px; min-height: 44px; }
.lobby-screen #room-ready-button { min-height: 64px; font-size: 22px; }
.lobby-compact .board-header { height: 92px; margin-bottom: 4px; }
.lobby-compact .title { font-size: 40px; }
.lobby-compact .connection-section { padding: 18px 24px; }
.lobby-compact .raccoon-stamp { height: 68px; margin-bottom: 2px; }
.lobby-compact .connection-section .section-title { font-size: 18px; }
.lobby-compact .lobby-actions { padding: 24px 30px; }
.lobby-compact .field-label { font-size: 16px; }
.lobby-compact #create-button { min-height: 90px; font-size: 29px; }
.lobby-compact .invite-divider { margin-top: 10px; margin-bottom: 6px; }
.lobby-compact .status-tag { min-height: 36px; padding: 6px 24px; }
