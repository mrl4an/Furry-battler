/* Shared desktop match composition. Lobby and Result keep their own styles. */
.match-screen { padding: 16px 24px; background-color: #291F24; color: #F3E4D1; }
.match-screen Button, .match-screen .section-title, .match-screen .round, .match-screen .timer, .match-screen .player-health, .match-screen .synergy-count, .match-screen .bid-value { -unity-font: url("Fonts/RussoOne-Regular.ttf"); -unity-font-style: normal; }
.match-screen Button { min-height: 44px; font-size: 18px; border-radius: 6px; }
.match-screen .auction-header { flex-direction: row; align-items: center; height: 68px; flex-shrink: 0; padding: 0 4px; }
.match-screen .game-title { flex-grow: 1; font-size: 20px; color: #B5A7B0; -unity-text-align: middle-right; margin-right: 24px; }
.match-screen .phase-banner { min-width: 230px; color: #291F24; background-image: url("Art/NoticePaper.png"); background-color: transparent; -unity-slice-left: 180; -unity-slice-right: 180; -unity-slice-top: 150; -unity-slice-bottom: 150; -unity-slice-scale: 0.12px; font-size: 32px; padding: 12px 28px; margin: 0; -unity-text-align: middle-center; }
.match-screen .round { font-size: 24px; margin-left: 24px; }
.match-screen .language-button { width: 76px; min-width: 76px; height: 44px; margin-left: 0; }
.match-screen .game-error { font-size: 18px; padding: 6px 12px; background-color: #342D38; margin: 4px 0; }
.match-layout { flex-direction: row; flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-height: 0; margin-top: 12px; }
.synergy-sidebar { width: 296px; flex-shrink: 0; margin-right: 20px; padding: 16px 10px; background-color: rgba(52, 45, 56, 0.92); border-width: 2px; border-color: #796573; border-radius: 12px 6px 12px 6px; }
.match-screen .synergy-sidebar > .section-title { font-size: 22px; -unity-text-align: middle-center; margin-bottom: 6px; }
.synergy-list { flex-grow: 1; min-height: 0; }
.synergy-entry { margin: 0 0 10px 0; padding: 10px 8px; background-color: #493E48; border-width: 1px; border-color: #796573; border-radius: 8px; }
.synergy-entry.active { border-left-width: 4px; border-left-color: #63DCC5; background-color: #3D4D49; }
.synergy-entry.inactive { opacity: 0.85; }
.synergy-row { flex-direction: row; align-items: center; min-height: 44px; }
.synergy-row > .class-icon { width: 34px; height: 34px; margin-right: 6px; }
.synergy-name { font-size: 18px; white-space: nowrap; flex-grow: 1; flex-shrink: 1; color: #F3E4D1; }
.synergy-count { color: #63DCC5; font-size: 24px; margin-left: 8px; flex-shrink: 0; }
.auction-table, .match-table { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; min-height: 0; background-color: rgba(41, 31, 36, 0.42); border-width: 2px; border-color: #796573; border-radius: 12px 6px 12px 6px; }
.opponent-hand-zone, .self-hand-zone { flex-shrink: 0; padding: 10px 24px; min-height: 0; }
.opponent-hand-zone { height: 228px; border-bottom-width: 1px; border-bottom-color: #796573; }
.self-hand-zone { height: 280px; border-top-width: 1px; border-top-color: #796573; }
.match-screen .self-hand-zone > .section-title { font-size: 20px; margin: 0; }
.match-screen .hint { font-size: 17px; color: #D8C9CF; white-space: normal; }
.auction-hand { flex-grow: 1; min-height: 0; }
.auction-hand > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container { flex-direction: row; padding: 18px 24px 30px 24px; align-items: center; }
.auction-hand .character-card { margin-right: 48px; }
.card-back { width: 100px; height: 132px; margin-right: 16px; flex-shrink: 0; background-color: #493E48; background-image: url("Art/RaccoonStamp.png"); background-size: 78% 65%; background-position: center; background-repeat: no-repeat; border-width: 3px; border-color: #A18B94; border-radius: 12px 6px 12px 6px; }
.auction-offers-zone { flex-grow: 1; flex-shrink: 1; min-height: 0; justify-content: center; padding: 24px; }
.auction-offers-zone > .hint { -unity-text-align: middle-center; margin-bottom: 26px; }
.auction-offers { flex-direction: row; align-items: center; justify-content: space-around; }
.auction-offer { align-items: center; min-width: 0; flex-shrink: 1; width: 20%; }
.auction-card-host { width: 160px; height: 192px; flex-shrink: 0; }
.bid-controls { flex-direction: row; align-items: center; justify-content: center; margin-top: 36px; padding: 4px; background-color: #291F24; border-radius: 8px; }
.match-screen .bid-controls Button { width: 40px; min-width: 40px; height: 40px; min-height: 40px; padding: 0; margin: 0; font-size: 26px; }
.bid-value { min-width: 66px; font-size: 26px; color: #DBB773; -unity-text-align: middle-center; }
.player-sidebar { width: 224px; flex-shrink: 0; margin-left: 20px; justify-content: space-between; }
.player-portrait { align-items: center; padding: 14px 10px; background-color: rgba(52, 45, 56, 0.94); border-width: 2px; border-color: #796573; border-radius: 10px; }
.shared-avatar { width: 96px; height: 96px; background-image: url("Art/RaccoonStamp.png"); background-size: contain; background-repeat: no-repeat; background-position: center; background-color: #E9D4B5; border-radius: 50px; border-width: 3px; border-color: #796573; }
.player-name { color: #F3E4D1; font-size: 22px; white-space: normal; -unity-text-align: middle-center; margin: 8px 0; }
.hud-stat { flex-direction: row; align-items: center; justify-content: center; }
.hud-icon { width: 34px; height: 34px; flex-shrink: 0; margin-right: 8px; background-size: contain; background-position: center; background-repeat: no-repeat; }
.health-icon { background-image: url("Art/Icons/health.svg"); }
.coin-icon { background-image: url("Art/Icons/coin-painted-v1.png"); }
.health-stat { padding: 5px 12px; background-color: #291F24; border-radius: 8px; }
.player-health { color: #F3E4D1; font-size: 30px; white-space: nowrap; margin: 0; }
.coin-stat { margin-top: 12px; }
.player-coins { color: #DBB773; font-size: 28px; white-space: nowrap; margin: 0; -unity-font: url("Fonts/RussoOne-Regular.ttf"); }
.available-stat { margin-top: 4px; }
.available-stat > Label { font-size: 18px; color: #D8C9CF; margin: 0 4px; white-space: nowrap; }
.auction-ready, .battle-status { background-color: #342D38; border-width: 2px; border-color: #796573; border-radius: 10px; padding: 16px 10px; }
.match-screen .timer { margin: 0 0 12px 0; min-width: 0; font-size: 30px; color: #F3E4D1; -unity-text-align: middle-center; }
.match-screen .auction-ready > Button { min-height: 72px; font-size: 30px; background-image: none; background-color: #63DCC5; color: #291F24; border-width: 2px 2px 4px 2px; border-color: #291F24; border-radius: 8px; padding: 8px; }
.match-screen .auction-ready > Button:hover { background-color: #85E8D5; }
.match-screen .auction-ready > Button:active { background-color: #43B8A5; border-bottom-width: 2px; }
.match-screen .auction-ready > Button:focus { border-color: #F3E4D1; }
.match-screen .auction-ready > Button:disabled { background-color: #46655F; color: #B3C3BE; }
.auction-ready > .hint, .battle-status > .section-title { -unity-text-align: middle-center; margin-top: 10px; }
.match-screen .paper-heading { align-self: flex-start; color: #291F24; background-color: #E9D4B5; padding: 4px 12px; border-radius: 3px; font-size: 22px; margin: 0; }
.preparation-table { padding: 12px 16px; }
.shop-zone { height: 292px; flex-shrink: 0; }
.match-screen .shop-row .character-card { width: 144px; height: 174px; }
.match-screen .section-header { min-height: 44px; margin-bottom: 10px; }
.match-screen .section-header Button { font-size: 18px; min-height: 40px; padding: 4px 10px; margin: 0; }
.match-screen .card-grid { flex-direction: row; align-items: center; justify-content: space-around; flex-grow: 1; flex-shrink: 1; min-height: 0; }
.match-screen .offer, .match-screen .board-slot { align-items: center; justify-content: center; width: 20%; min-width: 0; padding: 0; flex-shrink: 1; }
.match-screen .offer-actions { flex-direction: row; width: 196px; margin-top: 28px; }
.match-screen .offer-actions Button { font-size: 15px; min-height: 40px; width: 50%; padding: 2px; }
.match-screen .board-zone { height: 320px; flex-shrink: 0; padding-top: 8px; border-top-width: 1px; border-top-color: #796573; }
.match-screen .board-row { padding: 8px 12px 40px 12px; }
.match-screen .slot-heading { width: 196px; min-height: 32px; margin-bottom: 14px; }
.match-screen .slot-heading .slot-title { font-size: 17px; -unity-text-align: middle-center; }
.match-screen .slot-heading Button { min-height: 32px; font-size: 15px; padding: 2px 4px; }
.match-screen .preparation-hand-zone { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-height: 0; padding-top: 10px; border-top-width: 1px; border-top-color: #796573; }
.match-screen .hand-controls { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-height: 0; margin-top: 4px; }
.match-screen .hand-controls > Button { width: 32px; min-width: 32px; font-size: 22px; }
.match-screen .hand-scroll { flex-grow: 1; min-width: 0; min-height: 0; }
.match-screen .hand-scroll > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container { flex-direction: row; padding: 12px 28px 4px 28px; align-items: center; }
.match-screen .hand-item { width: 188px; height: auto; padding: 0 24px; justify-content: center; align-items: center; }
.match-screen .hand-item .character-card { width: 130px; height: 156px; }
.match-screen .hand-item > Button { margin-top: 26px; min-height: 28px; font-size: 16px; width: 140px; }
.match-screen #drag-hint { display: none; }
.battle-table { padding: 24px 16px; justify-content: center; }
.battle-zone { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-height: 0; justify-content: center; }
.match-screen .battle-zone > .section-title { margin: 0 12px 8px 12px; }
.match-screen .battle-zone > .board-row { flex-grow: 0; flex-shrink: 0; height: 300px; }
.battle-divider { height: 2px; background-color: #796573; margin: 16px 20px; flex-shrink: 0; }
.match-screen .battle-zone .character-card { width: 180px; height: 216px; }
.match-screen .battle-zone .character-merge { top: 230px; }
.empty-slot-role { position: absolute; width: 72px; height: 72px; left: 44px; top: 60px; opacity: 0.35; background-size: contain; background-position: center; background-repeat: no-repeat; }
.card-details-layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.card-details-scrim { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(20, 15, 20, 0.65); display: none; }
.card-details-layer.touch-details .card-details-scrim { display: flex; }
.card-details-host { position: absolute; width: 280px; height: 400px; }
.match-screen .close-card-details { position: absolute; min-width: 120px; height: 44px; }

/* Icon controls keep their existing server commands. */
.control-icon { width: 28px; height: 28px; flex-shrink: 0; background-size: contain; background-position: center; background-repeat: no-repeat; }
.refresh-icon { background-image: url("Art/Icons/refresh.svg"); }
.snowflake-icon { background-image: url("Art/Icons/snowflake.svg"); }
.match-screen .refresh-button { flex-direction: row; align-items: center; justify-content: center; }
.refresh-button > Label { margin: 0 5px; color: #291F24; -unity-font: url("Fonts/RussoOne-Regular.ttf"); font-size: 18px; }
.refresh-button > .refresh-icon { margin-right: 4px; }
.match-screen .offer-actions > Button { width: 144px; }
.match-screen .offer-actions > .freeze-button { width: 44px; min-width: 44px; margin-left: 6px; padding: 4px; align-items: center; justify-content: center; }
.match-screen .freeze-button.is-frozen { background-color: #A6DDEB; border-color: #E7FBFF; }
.match-screen .freeze-button:disabled { opacity: 0.5; }

.match-backdrop, .match-shade { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.match-backdrop { background-color: #342D38; background-size: cover; background-position: center; background-repeat: no-repeat; }
.match-shade { background-color: rgba(30, 25, 34, 0.48); }
.match-screen .synergy-help { width: 26px; min-width: 26px; height: 26px; min-height: 26px; padding: 0; margin: 0 0 0 4px; border-width: 1px; border-radius: 14px; background-color: transparent; color: #E9D4B5; border-color: #B4A2AB; font-size: 18px; flex-shrink: 0; }
.match-screen .synergy-help:hover, .match-screen .synergy-help:focus { background-color: #493E48; color: #63DCC5; border-color: #63DCC5; }
.synergy-help-panel { position: absolute; width: 360px; padding: 16px; background-color: #342D38; border-width: 2px; border-color: #C9BDAE; border-radius: 10px; }
.synergy-help-panel > Label { color: #F3E4D1; white-space: normal; font-size: 20px; margin: 4px 0; }
.synergy-help-panel > #synergy-help-rules { font-size: 17px; color: #D8C9CF; margin-top: 12px; }
.hand-zone-mark { flex-direction: row; align-items: center; align-self: flex-start; padding: 3px 10px; background-color: rgba(41, 31, 36, 0.75); border-radius: 8px; }
.hand-zone-icon { width: 34px; height: 34px; background-image: url("Art/Icons/cards.svg"); background-size: contain; background-repeat: no-repeat; }
.hand-count { font-size: 22px; color: #E9D4B5; margin: 0 0 0 8px; -unity-font: url("Fonts/RussoOne-Regular.ttf"); }
.self-mark { border-left-width: 3px; border-left-color: #63DCC5; }
.opponent-mark { border-left-width: 3px; border-left-color: #D77C6F; }
.self-hand-zone, .preparation-hand-zone { background-color: rgba(50, 77, 71, 0.22); }
.opponent-hand-zone { background-color: rgba(92, 54, 61, 0.18); }
.drag-card-ghost { opacity: 0.9; }
.drag-source { opacity: 0.35; }

/* The drag overlay is outside flex flow; inline card positioning wins template styles. */
.match-screen > .drag-layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.match-screen.preparation-screen .player-sidebar { justify-content: space-between; }
.match-screen.preparation-screen .player-portrait, .match-screen.preparation-screen .auction-ready { flex-shrink: 0; }
.sale-zone { height: 166px; min-height: 166px; flex-shrink: 0; padding: 10px 12px; margin: 8px 0; align-items: center; justify-content: center; background-image: url("Art/NoticePaper.png"); -unity-slice-left: 180; -unity-slice-right: 180; -unity-slice-top: 150; -unity-slice-bottom: 150; -unity-slice-scale: 0.12px; border-width: 2px; border-color: rgba(219, 183, 115, 0.4); border-radius: 8px; }
.sale-zone > .section-title { color: #291F24; font-size: 24px; margin: 0; -unity-text-align: middle-center; }
.sale-emblem { width: 48px; height: 48px; margin: 2px 0; background-size: contain; background-repeat: no-repeat; background-position: center; }
.sale-hint { color: #59404D; font-size: 16px; white-space: normal; -unity-text-align: middle-center; margin: 0; }
.sale-zone .hud-stat { height: 32px; min-height: 32px; margin-top: 2px; }
.sale-zone .hud-icon { width: 24px; height: 24px; }
.sale-zone #sale-price { color: #291F24; font-size: 24px; -unity-font: url("Fonts/RussoOne-Regular.ttf"); margin: 0; }
.sale-price-hidden { visibility: hidden; }
.sale-zone.drop-hover { border-color: #63DCC5; -unity-background-image-tint-color: #D1FFF5; }
.sale-zone:disabled { opacity: 0.5; }
.match-screen .preparation-hand-zone { border-width: 2px; border-color: transparent; border-top-color: #796573; }
.match-screen .preparation-hand-zone.drop-hover { border-color: rgba(99, 220, 197, 0.85); }
