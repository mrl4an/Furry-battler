<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Template name="CharacterCard" src="Resources/Cards/CharacterCard.uxml" />
    <ui:Style src="LobbyView.uss" />
    <ui:Style src="AuctionView.uss" />
    <ui:Style src="Resources/Cards/CharacterCard.uss" />
    <ui:VisualElement name="game-screen" class="game-screen match-screen auction-screen">
        <ui:VisualElement name="match-backdrop" class="match-backdrop" picking-mode="Ignore" />
        <ui:VisualElement class="match-shade" picking-mode="Ignore" />
        <ui:VisualElement class="auction-header">
            <ui:Label name="stage-heading" class="section-title phase-banner" />
            <ui:Label name="round" class="round" />
            <ui:Label name="game-title" class="game-title" />
            <ui:Button name="language-button" class="language-button" />
        </ui:VisualElement>
        <ui:Label name="game-error" class="game-error hidden" />
        <ui:VisualElement class="auction-layout match-layout">
            <ui:VisualElement class="synergy-sidebar">
                <ui:Label name="synergy-heading" class="section-title" />
                <ui:ScrollView name="synergies" mode="Vertical" class="capsule-scroll synergy-list" horizontal-scroller-visibility="Hidden">
                    <ui:VisualElement name="synergy-pack" class="synergy-entry inactive">
                        <ui:VisualElement class="synergy-row"><ui:VisualElement class="class-icon group-pack" /><ui:Label name="synergy-name" class="synergy-name" /><ui:Button name="synergy-help" class="synergy-help" /><ui:Label name="synergy-count" class="synergy-count" /></ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="synergy-armored" class="synergy-entry inactive">
                        <ui:VisualElement class="synergy-row"><ui:VisualElement class="class-icon group-armored" /><ui:Label name="synergy-name" class="synergy-name" /><ui:Button name="synergy-help" class="synergy-help" /><ui:Label name="synergy-count" class="synergy-count" /></ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="synergy-forest" class="synergy-entry inactive">
                        <ui:VisualElement class="synergy-row"><ui:VisualElement class="class-icon group-forest" /><ui:Label name="synergy-name" class="synergy-name" /><ui:Button name="synergy-help" class="synergy-help" /><ui:Label name="synergy-count" class="synergy-count" /></ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="synergy-feathered" class="synergy-entry inactive">
                        <ui:VisualElement class="synergy-row"><ui:VisualElement class="class-icon group-feathered" /><ui:Label name="synergy-name" class="synergy-name" /><ui:Button name="synergy-help" class="synergy-help" /><ui:Label name="synergy-count" class="synergy-count" /></ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="synergy-venomous" class="synergy-entry inactive">
                        <ui:VisualElement class="synergy-row"><ui:VisualElement class="class-icon group-venomous" /><ui:Label name="synergy-name" class="synergy-name" /><ui:Button name="synergy-help" class="synergy-help" /><ui:Label name="synergy-count" class="synergy-count" /></ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="synergy-urban" class="synergy-entry inactive">
                        <ui:VisualElement class="synergy-row"><ui:VisualElement class="class-icon group-urban" /><ui:Label name="synergy-name" class="synergy-name" /><ui:Button name="synergy-help" class="synergy-help" /><ui:Label name="synergy-count" class="synergy-count" /></ui:VisualElement>
                    </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>
            <ui:VisualElement class="auction-table">
                <ui:VisualElement class="opponent-hand-zone">
                    <ui:VisualElement class="hand-zone-mark opponent-mark"><ui:VisualElement class="hand-zone-icon" picking-mode="Ignore" /><ui:Label name="opponent-hand-count" class="hand-count" /></ui:VisualElement>
                    <ui:ScrollView name="opponent-hand" mode="Horizontal" class="capsule-scroll auction-hand" horizontal-scroller-visibility="Auto" vertical-scroller-visibility="Hidden" />
                </ui:VisualElement>
                <ui:VisualElement class="auction-offers-zone">
                    <ui:Label name="auction-hint" class="hint" />
                    <ui:VisualElement name="offers" class="auction-offers">
                        <ui:VisualElement name="offer-0" class="auction-offer">
                            <ui:VisualElement name="opponent-bet" class="opponent-bet hidden">
                                <ui:VisualElement name="reveal-opponent-tray" class="bet-tray"><ui:VisualElement name="reveal-opponent-coins" class="bet-coins" picking-mode="Ignore" /><ui:Label name="reveal-opponent-bid" class="reveal-bid-number bet-value" /></ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement name="card-host" class="auction-card-host"><ui:Instance template="CharacterCard" /></ui:VisualElement>
                            <ui:VisualElement name="bid-controls" class="bid-controls">
                                <ui:Button name="bid-place" class="bet-tray"><ui:VisualElement name="bid-coins" class="bet-coins" picking-mode="Ignore" /><ui:Label name="bid-value" class="bid-value bet-value" picking-mode="Ignore" /></ui:Button>
                                <ui:Button name="bid-refund" class="bid-refund"><ui:VisualElement class="bid-refund-icon" picking-mode="Ignore" /></ui:Button>
                            </ui:VisualElement>
                            <ui:VisualElement name="reveal-bids" class="reveal-bids hidden">
                                <ui:VisualElement name="reveal-self-tray" class="bet-tray"><ui:VisualElement name="reveal-self-coins" class="bet-coins" picking-mode="Ignore" /><ui:Label name="reveal-self-bid" class="reveal-bid-number bet-value" /></ui:VisualElement>
                                <ui:Label name="reveal-lot-status" class="reveal-lot-status" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="offer-1" class="auction-offer">
                            <ui:VisualElement name="opponent-bet" class="opponent-bet hidden">
                                <ui:VisualElement name="reveal-opponent-tray" class="bet-tray"><ui:VisualElement name="reveal-opponent-coins" class="bet-coins" picking-mode="Ignore" /><ui:Label name="reveal-opponent-bid" class="reveal-bid-number bet-value" /></ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement name="card-host" class="auction-card-host"><ui:Instance template="CharacterCard" /></ui:VisualElement>
                            <ui:VisualElement name="bid-controls" class="bid-controls">
                                <ui:Button name="bid-place" class="bet-tray"><ui:VisualElement name="bid-coins" class="bet-coins" picking-mode="Ignore" /><ui:Label name="bid-value" class="bid-value bet-value" picking-mode="Ignore" /></ui:Button>
                                <ui:Button name="bid-refund" class="bid-refund"><ui:VisualElement class="bid-refund-icon" picking-mode="Ignore" /></ui:Button>
                            </ui:VisualElement>
                            <ui:VisualElement name="reveal-bids" class="reveal-bids hidden">
                                <ui:VisualElement name="reveal-self-tray" class="bet-tray"><ui:VisualElement name="reveal-self-coins" class="bet-coins" picking-mode="Ignore" /><ui:Label name="reveal-self-bid" class="reveal-bid-number bet-value" /></ui:VisualElement>
                                <ui:Label name="reveal-lot-status" class="reveal-lot-status" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="offer-2" class="auction-offer">
                            <ui:VisualElement name="opponent-bet" class="opponent-bet hidden">
                                <ui:VisualElement name="reveal-opponent-tray" class="bet-tray"><ui:VisualElement name="reveal-opponent-coins" class="bet-coins" picking-mode="Ignore" /><ui:Label name="reveal-opponent-bid" class="reveal-bid-number bet-value" /></ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement name="card-host" class="auction-card-host"><ui:Instance template="CharacterCard" /></ui:VisualElement>
                            <ui:VisualElement name="bid-controls" class="bid-controls">
                                <ui:Button name="bid-place" class="bet-tray"><ui:VisualElement name="bid-coins" class="bet-coins" picking-mode="Ignore" /><ui:Label name="bid-value" class="bid-value bet-value" picking-mode="Ignore" /></ui:Button>
                                <ui:Button name="bid-refund" class="bid-refund"><ui:VisualElement class="bid-refund-icon" picking-mode="Ignore" /></ui:Button>
                            </ui:VisualElement>
                            <ui:VisualElement name="reveal-bids" class="reveal-bids hidden">
                                <ui:VisualElement name="reveal-self-tray" class="bet-tray"><ui:VisualElement name="reveal-self-coins" class="bet-coins" picking-mode="Ignore" /><ui:Label name="reveal-self-bid" class="reveal-bid-number bet-value" /></ui:VisualElement>
                                <ui:Label name="reveal-lot-status" class="reveal-lot-status" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="offer-3" class="auction-offer">
                            <ui:VisualElement name="opponent-bet" class="opponent-bet hidden">
                                <ui:VisualElement name="reveal-opponent-tray" class="bet-tray"><ui:VisualElement name="reveal-opponent-coins" class="bet-coins" picking-mode="Ignore" /><ui:Label name="reveal-opponent-bid" class="reveal-bid-number bet-value" /></ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement name="card-host" class="auction-card-host"><ui:Instance template="CharacterCard" /></ui:VisualElement>
                            <ui:VisualElement name="bid-controls" class="bid-controls">
                                <ui:Button name="bid-place" class="bet-tray"><ui:VisualElement name="bid-coins" class="bet-coins" picking-mode="Ignore" /><ui:Label name="bid-value" class="bid-value bet-value" picking-mode="Ignore" /></ui:Button>
                                <ui:Button name="bid-refund" class="bid-refund"><ui:VisualElement class="bid-refund-icon" picking-mode="Ignore" /></ui:Button>
                            </ui:VisualElement>
                            <ui:VisualElement name="reveal-bids" class="reveal-bids hidden">
                                <ui:VisualElement name="reveal-self-tray" class="bet-tray"><ui:VisualElement name="reveal-self-coins" class="bet-coins" picking-mode="Ignore" /><ui:Label name="reveal-self-bid" class="reveal-bid-number bet-value" /></ui:VisualElement>
                                <ui:Label name="reveal-lot-status" class="reveal-lot-status" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="offer-4" class="auction-offer">
                            <ui:VisualElement name="opponent-bet" class="opponent-bet hidden">
                                <ui:VisualElement name="reveal-opponent-tray" class="bet-tray"><ui:VisualElement name="reveal-opponent-coins" class="bet-coins" picking-mode="Ignore" /><ui:Label name="reveal-opponent-bid" class="reveal-bid-number bet-value" /></ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement name="card-host" class="auction-card-host"><ui:Instance template="CharacterCard" /></ui:VisualElement>
                            <ui:VisualElement name="bid-controls" class="bid-controls">
                                <ui:Button name="bid-place" class="bet-tray"><ui:VisualElement name="bid-coins" class="bet-coins" picking-mode="Ignore" /><ui:Label name="bid-value" class="bid-value bet-value" picking-mode="Ignore" /></ui:Button>
                                <ui:Button name="bid-refund" class="bid-refund"><ui:VisualElement class="bid-refund-icon" picking-mode="Ignore" /></ui:Button>
                            </ui:VisualElement>
                            <ui:VisualElement name="reveal-bids" class="reveal-bids hidden">
                                <ui:VisualElement name="reveal-self-tray" class="bet-tray"><ui:VisualElement name="reveal-self-coins" class="bet-coins" picking-mode="Ignore" /><ui:Label name="reveal-self-bid" class="reveal-bid-number bet-value" /></ui:VisualElement>
                                <ui:Label name="reveal-lot-status" class="reveal-lot-status" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="self-hand-zone">
                    <ui:VisualElement class="hand-zone-mark self-mark"><ui:VisualElement class="hand-zone-icon" picking-mode="Ignore" /><ui:Label name="hand-heading" class="hand-count" /></ui:VisualElement>
                    <ui:ScrollView name="auction-hand" mode="Horizontal" class="capsule-scroll auction-hand" horizontal-scroller-visibility="Auto" vertical-scroller-visibility="Hidden" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="player-sidebar">
                <ui:VisualElement class="player-portrait"><ui:VisualElement class="shared-avatar" /><ui:Label name="opponent-name" class="player-name" /><ui:VisualElement class="hud-stat health-stat"><ui:VisualElement class="hud-icon health-icon" picking-mode="Ignore" /><ui:Label name="opponent-health" class="player-health" /></ui:VisualElement></ui:VisualElement>
                <ui:VisualElement class="auction-ready">
                    <ui:Label name="timer" class="timer" />
                    <ui:Button name="ready-button" class="primary-button" />
                    <ui:Label name="ready-status" class="hint" />
                </ui:VisualElement>
                <ui:VisualElement class="player-portrait"><ui:VisualElement class="shared-avatar" /><ui:Label name="self-name" class="player-name" /><ui:VisualElement class="hud-stat health-stat"><ui:VisualElement class="hud-icon health-icon" picking-mode="Ignore" /><ui:Label name="self-health" class="player-health" /></ui:VisualElement><ui:VisualElement class="hud-stat coin-stat"><ui:VisualElement class="hud-icon coin-icon" picking-mode="Ignore" /><ui:Label name="self-coins" class="player-coins" /></ui:VisualElement><ui:VisualElement class="hud-stat available-stat"><ui:Label name="available-caption" /><ui:Label name="available-coins" /></ui:VisualElement></ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="auction-reveal-fx" class="auction-reveal-fx" picking-mode="Ignore" />
        <ui:VisualElement name="synergy-help-panel" class="synergy-help-panel hidden" picking-mode="Ignore">
            <ui:Label name="synergy-help-title" class="section-title" picking-mode="Ignore" />
            <ui:Label name="synergy-help-body" picking-mode="Ignore" />
            <ui:Label name="synergy-help-rules" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="card-details-layer" class="card-details-layer hidden" picking-mode="Ignore">
            <ui:VisualElement name="card-details-scrim" class="card-details-scrim" />
            <ui:VisualElement name="card-details-host" class="card-details-host" />
            <ui:Button name="close-card-details" class="close-card-details hidden" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
