.character-card { width: 160px; height: 192px; flex-grow: 0; flex-shrink: 0; position: relative; overflow: visible; color: #F3E4D1; -unity-font: url("../../Fonts/NotoSans-Regular.ttf"); }
.character-frame { position: absolute; left: 0; right: 0; top: 0; bottom: 0; overflow: hidden; padding: 5px; background-color: #342D38; border-width: 4px; border-color: #C9BDAE; border-radius: 12px 6px 12px 6px; }
.character-card.rarity-rare > .character-frame { border-color: #A6BEC3; }
.character-card.rarity-epic > .character-frame { border-color: #A999B0; }
.character-card:hover > .character-frame, .character-card:focus > .character-frame { background-color: #493E48; }
.character-card:focus > .character-frame { border-color: #63DCC5; }
.character-card.is-frozen > .character-frame { background-color: #3C5965; }
.character-art { flex-grow: 1; min-height: 0; background-color: #D5C0A6; background-size: contain; background-position: center; background-repeat: no-repeat; border-radius: 10px; }
.character-art.has-portrait { background-size: cover; background-position: center top; }
.class-icon { width: 34px; height: 34px; flex-shrink: 0; background-size: contain; background-repeat: no-repeat; background-position: center; }
.group-pack { background-image: url("../../Art/ClassIcons/pack-v3.png"); }
.group-armored { background-image: url("../../Art/ClassIcons/armored-v3.png"); }
.group-forest { background-image: url("../../Art/ClassIcons/forest-v3.png"); }
.group-feathered { background-image: url("../../Art/ClassIcons/feathered-v3.png"); }
.group-venomous { background-image: url("../../Art/ClassIcons/venomous-v3.png"); }
.group-urban { background-image: url("../../Art/ClassIcons/urban-v3.png"); }
.corner-class { position: absolute; left: -14px; top: -14px; width: 40px; height: 40px; }
.role-icon { position: absolute; right: -12px; top: -12px; width: 34px; height: 34px; background-size: contain; background-repeat: no-repeat; background-position: center; }
.role-attack { background-image: url("../../Art/Icons/role-attack-v2.png"); }
.role-support { background-image: url("../../Art/Icons/role-support-v3.png"); }
.role-defense { background-image: url("../../Art/Icons/role-defense-v2.png"); }
.character-stat { position: absolute; bottom: -14px; width: 54px; height: 48px; align-items: center; justify-content: center; background-size: contain; background-position: center; background-repeat: no-repeat; }
.character-attack { left: -24px; bottom: -22px; width: 62px; height: 54px; padding: 0 4px 14px 0; background-image: url("../../Art/Icons/attack-stat-v5.png"); }
.character-health { right: -18px; padding-top: 5px; background-image: url("../../Art/Icons/health.svg"); }
.stat-number { -unity-font: url("../../Fonts/RussoOne-Regular.ttf"); -unity-font-style: bold; font-size: 24px; color: #291F24; background-color: transparent; text-shadow: 0 0 3px rgba(255, 245, 222, 0.7); min-width: 28px; height: 30px; padding: 0 3px; margin: 0; -unity-text-align: middle-center; flex-shrink: 0; white-space: nowrap; }
.stat-number.wide-number { font-size: 19px; }
.character-merge { position: absolute; top: 206px; left: 32px; right: 32px; align-items: center; }
.merge-drops { flex-direction: row; }
.merge-drop { width: 18px; height: 9px; margin: 0 2px; background-color: #746874; border-radius: 7px 7px 7px 1px; }
.merge-drop.filled { background-color: #63DCC5; }
.character-card .full-only { display: none; }
.character-card.detailed-card { width: 280px; height: 400px; }
.detailed-card .full-only { display: flex; }
.detailed-card .corner-class { display: none; }
.detailed-card .character-frame { padding: 8px; }
.character-name { color: #291F24; background-color: #E9D4B5; -unity-font: url("../../Fonts/RussoOne-Regular.ttf"); font-size: 22px; -unity-font-style: normal; -unity-text-align: middle-center; white-space: normal; margin: 0 0 5px 0; padding: 2px; flex-shrink: 0; }
.detailed-card .character-art { flex-grow: 0; flex-shrink: 0; height: 138px; }
.detailed-card.no-ability .character-art { flex-grow: 1; }
.character-class-row { flex-direction: row; align-items: center; justify-content: center; flex-shrink: 0; margin: 4px 0; }
.character-group { font-size: 17px; white-space: normal; flex-shrink: 1; margin: 0 0 0 6px; -unity-text-align: middle-center; color: #E9D4B5; }
.character-ability { flex-grow: 1; min-height: 0; white-space: normal; font-size: 18px; color: #F3E4D1; background-color: #493E48; padding: 5px; margin: 0 0 8px 0; border-width: 1px; border-color: #796573; border-radius: 5px; }
.detailed-card .role-icon { top: 206px; }
.detailed-card .character-merge { top: 414px; }
.character-card.empty-character .character-art, .character-card.empty-character .class-icon, .character-card.empty-character .role-icon, .character-card.empty-character .character-stat, .character-card.empty-character .character-merge { display: none; }
.empty-character > .character-frame { opacity: 1; background-color: rgba(41, 31, 36, 0.12); border-color: rgba(99, 220, 197, 0.32); }

/* Frost is confined to the portrait; stats and controls stay readable. */
.frost-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; display: none; background-image: url("../../Art/Icons/frost-overlay.svg"); background-size: 100% 100%; background-repeat: no-repeat; }
.character-card.is-frozen .frost-overlay { display: flex; }

.character-card.slot-drop-hover > .character-frame { border-color: rgba(99, 220, 197, 0.95); }

/* Prepared vector halos distinguish attack readiness from the marked target. */
.character-battle-glow { position: absolute; left: -28px; right: -28px; top: -28px; bottom: -28px; display: none; background-size: 100% 100%; background-repeat: no-repeat; }
.character-card.battle-attacker > .character-battle-glow { display: flex; background-image: url("../Battle/attacker-glow.svg"); }
.character-card.battle-target > .character-battle-glow { display: flex; background-image: url("../Battle/target-glow.svg"); }
.character-card.battle-attacker > .character-frame { border-color: #63DCC5; }
.character-card.battle-target > .character-frame { border-color: #F0A18F; }
.stat-delta { position: absolute; left: -24px; top: -24px; width: 96px; margin: 0; -unity-font: url("../../Fonts/RussoOne-Regular.ttf"); font-size: 26px; -unity-text-align: middle-center; text-shadow: 0 0 4px rgba(41, 31, 36, 0.9); }
.stat-number.stat-gain, .stat-delta.stat-gain { color: #63DCC5; }
.stat-number.stat-loss, .stat-delta.stat-loss { color: #F0A18F; }
.stat-number.stat-poison, .stat-delta.stat-poison { color: #C7A6E6; }
.stat-number.stat-expired, .stat-delta.stat-expired { color: #DBB773; }
.character-shadow { position: absolute; left: -14px; right: -14px; top: 8px; bottom: -20px; background-image: url("../Battle/card-shadow.svg"); background-size: 100% 100%; background-repeat: no-repeat; }
.empty-character > .character-shadow { display: none; }
.battle-fallen .character-art { opacity: 0.48; }
.battle-fallen > .character-frame { border-color: #796573; }
.battle-victor > .character-frame { border-color: #FFE7A2; }
.preparation-tier-up > .character-frame { border-color: #FFE7A2; }
