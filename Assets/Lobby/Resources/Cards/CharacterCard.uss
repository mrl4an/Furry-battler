.character-card { width: 160px; height: 192px; flex-grow: 0; flex-shrink: 0; position: relative; overflow: visible; color: #F3E4D1; -unity-font: url("../../Fonts/NotoSans-Regular.ttf"); }
.character-frame { position: absolute; left: 0; right: 0; top: 0; bottom: 0; overflow: hidden; padding: 5px; background-color: #342D38; border-width: 4px; border-color: #C9BDAE; border-radius: 18px 10px 18px 10px; }
.character-card.rarity-rare > .character-frame { border-color: #A6BEC3; }
.character-card.rarity-epic > .character-frame { border-color: #A999B0; }
.character-card:hover > .character-frame, .character-card:focus > .character-frame { background-color: #493E48; }
.character-art { flex-grow: 1; min-height: 0; background-color: #493E48; background-size: contain; background-position: center; background-repeat: no-repeat; border-radius: 10px; }
.character-art.has-portrait { background-size: cover; background-position: center top; }
.class-icon { width: 34px; height: 34px; flex-shrink: 0; background-size: contain; background-repeat: no-repeat; background-position: center; }
.group-pack { background-image: url("../../Art/ClassIcons/pack.png"); }
.group-armored { background-image: url("../../Art/ClassIcons/armored.png"); }
.group-forest { background-image: url("../../Art/ClassIcons/forest.png"); }
.group-feathered { background-image: url("../../Art/ClassIcons/feathered.png"); }
.group-venomous { background-image: url("../../Art/ClassIcons/venomous.png"); }
.group-urban { background-image: url("../../Art/ClassIcons/urban.png"); }
.corner-class { position: absolute; left: -14px; top: -14px; width: 40px; height: 40px; }
.role-icon { position: absolute; right: -12px; top: -12px; width: 34px; height: 34px; background-size: contain; background-repeat: no-repeat; background-position: center; }
.role-attack { background-image: url("../../Art/Icons/role-attack.svg"); }
.role-support { background-image: url("../../Art/Icons/role-support.svg"); }
.role-defense { background-image: url("../../Art/Icons/role-defense.svg"); }
.character-stat { position: absolute; bottom: -12px; width: 46px; height: 42px; margin: 0; padding: 6px 0 0 0; -unity-text-align: middle-center; -unity-font-style: bold; font-size: 19px; color: #291F24; background-size: contain; background-position: center; background-repeat: no-repeat; }
.character-attack { left: -16px; background-image: url("../../Art/Icons/attack.svg"); }
.character-health { right: -16px; background-image: url("../../Art/Icons/health.svg"); }
.character-merge { position: absolute; top: 206px; left: 32px; right: 32px; align-items: center; }
.merge-drops { flex-direction: row; }
.merge-drop { width: 18px; height: 9px; margin: 0 2px; background-color: #746874; border-radius: 7px 7px 7px 1px; }
.merge-drop.filled { background-color: #63DCC5; }
.character-tier { font-size: 12px; color: #E9D4B5; -unity-text-align: middle-center; margin: 1px 0 0 0; }
.character-card .full-only { display: none; }
.character-card.detailed-card { width: 224px; height: 320px; }
.detailed-card .full-only { display: flex; }
.detailed-card .corner-class { display: none; }
.detailed-card .character-frame { padding: 8px; }
.character-name { color: #291F24; background-color: #E9D4B5; font-size: 17px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal; margin: 0 0 5px 0; padding: 2px; flex-shrink: 0; }
.detailed-card .character-art { flex-grow: 0; flex-shrink: 0; height: 104px; }
.character-class-row { flex-direction: row; align-items: center; flex-shrink: 0; margin: 4px 0; }
.character-group { font-size: 13px; white-space: normal; flex-shrink: 1; margin: 0 0 0 3px; color: #E9D4B5; }
.character-ability { flex-grow: 1; min-height: 0; white-space: normal; font-size: 13px; color: #F3E4D1; background-color: #493E48; padding: 5px; margin: 0 0 8px 0; border-width: 1px; border-color: #796573; border-radius: 5px; }
.detailed-card .role-icon { top: 177px; }
.detailed-card .character-merge { top: 330px; }
.character-card.empty-character .character-art, .character-card.empty-character .class-icon, .character-card.empty-character .role-icon, .character-card.empty-character .character-stat, .character-card.empty-character .character-merge { display: none; }
.empty-character > .character-frame { opacity: 0.4; }
