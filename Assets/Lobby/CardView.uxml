<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="game-card" class="game-card">
        <ui:VisualElement class="card-meta">
            <ui:Label name="card-tier" class="card-tier" />
            <ui:Label name="card-group" class="card-group" />
        </ui:VisualElement>
        <ui:Label name="card-art" class="card-art" />
        <ui:Label name="card-name" class="card-name" />
        <ui:Label name="card-ability" class="card-ability" />
        <ui:VisualElement class="card-footer">
            <ui:Label name="card-stats" class="card-stats" />
            <ui:Label name="card-copies" class="card-copies" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
