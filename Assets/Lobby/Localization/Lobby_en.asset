  - m_Id: 1114628242
    m_Localized: "3/8/15 Pack copies: at preparation start, receive 0/1/2 pack cubs. Cub plays improve future cubs."
    m_Metadata:
      m_Items: []
  - m_Id: 1114628243
    m_Localized: "3/8/15 Armored copies: at preparation end, all Armored allies permanently gain +2/+4/+9 health."
    m_Metadata:
      m_Items: []
  - m_Id: 1114628244
    m_Localized: "3/8/15 Forest copies: at preparation end, each cache gains 1/2/3 opening progress. At 3, it is consumed and applies one nut to every ally."
    m_Metadata:
      m_Items: []
  - m_Id: 1114628245
    m_Localized: "3/8/15 Feathered copies: every own attack adds +2/+4/+7 attack until battle ends. Counters do not trigger the increase."
    m_Metadata:
      m_Items: []
  - m_Id: 1114628246
    m_Localized: "3/8/15 Venomous copies: each poison application gains +1/+3/+8 strength. Poison stacks until battle ends."
    m_Metadata:
      m_Items: []
  - m_Id: 1114628247
    m_Localized: "3/8/15 Urban copies: receive +2/+5/+10 coins before the next round's auction."
    m_Metadata:
      m_Items: []
  - m_Id: 1114628248
    m_Localized: "Thresholds: 3 / 8 / 15 field copies. Effects depend on the class."
    m_Metadata:
      m_Items: []
  - m_Id: 1114628249
    m_Localized: "Preparation start: 0 / 1 / 2 pack cubs"
    m_Metadata:
      m_Items: []
  - m_Id: 1114628250
    m_Localized: "Preparation end: permanent +2 / +4 / +9 health"
    m_Metadata:
      m_Items: []
  - m_Id: 1114628251
    m_Localized: "Preparation end: +1 / +2 / +3 cache progress"
    m_Metadata:
      m_Items: []
  - m_Id: 1114628252
    m_Localized: "Each own attack: +2 / +4 / +7 attack for this battle"
    m_Metadata:
      m_Items: []
  - m_Id: 1114628253
    m_Localized: "Poison strength +1 / +3 / +8"
    m_Metadata:
